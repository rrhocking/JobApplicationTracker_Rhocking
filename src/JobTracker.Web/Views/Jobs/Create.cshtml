@model JobApplication
@{
    ViewData["Title"] = "Add job";
}

<h1>Add a job</h1>

<form asp-action="Create" method="post" class="card">
    <partial name="_Form" model="Model" />
    <div class="actions">
        <button type="submit" class="button">Save</button>
        <a asp-action="Index" class="link">Cancel</a>
    </div>
</form>
