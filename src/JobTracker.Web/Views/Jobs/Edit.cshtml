@model JobApplication
@{
    ViewData["Title"] = "Edit job";
}

<h1>Edit job</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card">
    <partial name="_Form" model="Model" />
    <div class="actions">
        <button type="submit" class="button">Save changes</button>
        <a asp-action="Index" class="link">Cancel</a>
    </div>
</form>
